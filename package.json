{
  "name": "footbag-panel-generator",
  "version": "1.0.0",
  "description": "Generate SVG patterns for footbag panels",
  "type": "module",
  "scripts": {
  "dev": "vite",
  "build": "tsc && vite build",
  "preview": "vite preview",
  "type-check": "tsc --noEmit",
  "test:auto-nesting": "tsc -p tsconfig.test.json && node --test tests/autoNesting.test.mjs"
},
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^4.9.5",
    "vite": "^4.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "footbag",
    "hackysack",
    "svg",
    "panel",
    "generator"
  ],
  "author": "Ivan Iakimenko",
  "license": "MIT"
}
