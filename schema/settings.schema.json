{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schema/settings.schema.json",
  "title": "Footbag Panel Settings",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "shape": {
      "type": "integer",
      "enum": [
        3,
        4,
        5,
        6,
        10
      ]
    },
    "curved": {
      "type": "boolean"
    },
    "curveRadius": {
      "type": "number",
      "minimum": 10,
      "maximum": 130
    },
    "side": {
      "type": "number",
      "minimum": 10,
      "maximum": 80
    },
    "seam": {
      "type": "number",
      "minimum": 0,
      "maximum": 9
    },
    "stitches": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "showGrid": {
      "type": "boolean"
    },
    "cornerMargin": {
      "type": "number",
      "minimum": 0
    },
    "holeSpacing": {
      "type": "number",
      "minimum": 1
    },
    "dotSize": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 1.5
    },
    "hex": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "regular",
            "truncated"
          ]
        },
        "long": {
          "type": "number",
          "minimum": 10,
          "maximum": 80
        },
        "ratio": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.9
        }
      },
      "additionalProperties": false
    },
    "$schema": {
      "type": "string"
    },
    "showHoles": {
      "type": "boolean"
    },
    "holeBunching": {
      "type": "number",
      "minimum": 0
    },
    "starRootOffset": {
      "type": "number",
      "minimum": -3,
      "maximum": 1
    },
    "starRootAngle": {
      "type": "number",
      "minimum": 100,
      "maximum": 150
    },
    "cornerStitchSpacing": {
      "type": "boolean"
    },
    "cornerStitchDistance": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 10
    },
    "export": {
      "type": "object",
      "properties": {
        "scalePercent": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "padding": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "hSpace": {
          "type": "number",
          "minimum": -20,
          "maximum": 50
        },
        "vSpace": {
          "type": "number",
          "minimum": -20,
          "maximum": 60
        },
        "invert": {
          "type": "boolean"
        },
        "nestingOffset": {
          "type": "number",
          "minimum": -40,
          "maximum": 40
        },
        "showGrid": {
          "type": "boolean"
        },
        "optimized": {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "source": {
              "type": "string",
              "maxLength": 2048
            },
            "gap": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            },
            "placements": {
              "type": "array",
              "minItems": 1,
              "maxItems": 144,
              "items": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  "angle": {
                    "enum": [
                      0,
                      90,
                      180,
                      270
                    ]
                  },
                  "flipY": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "angle"
                ],
                "additionalProperties": false
              }
            },
            "rotations": {
              "enum": [
                "none",
                "half",
                "quarter"
              ]
            },
            "stock": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "fit",
                    "capacity"
                  ]
                },
                "width": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 10000
                },
                "height": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 10000
                }
              },
              "required": [
                "mode",
                "width"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "capacity"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "height"
                    ]
                  }
                }
              ],
              "additionalProperties": false
            },
            "lattice": {
              "type": "object",
              "properties": {
                "columns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 144
                },
                "pitchX": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000
                },
                "pitchY": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000
                },
                "pattern": {
                  "enum": [
                    0,
                    1,
                    2,
                    3,
                    4
                  ]
                },
                "angle": {
                  "enum": [
                    0,
                    90,
                    180,
                    270
                  ]
                },
                "rotateAlternates": {
                  "type": "boolean"
                }
              },
              "required": [
                "columns",
                "pitchX",
                "pitchY",
                "pattern",
                "angle",
                "rotateAlternates"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "version",
            "source",
            "gap",
            "placements"
          ],
          "additionalProperties": false
        },
        "nesting": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "free",
                "fit",
                "capacity"
              ]
            },
            "rotations": {
              "enum": [
                "none",
                "half",
                "quarter"
              ]
            },
            "width": {
              "type": "number",
              "minimum": 1,
              "maximum": 10000
            },
            "height": {
              "type": "number",
              "minimum": 1,
              "maximum": 10000
            },
            "gap": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            }
          },
          "required": [
            "mode",
            "rotations"
          ],
          "additionalProperties": false
        },
        "editable": {
          "type": "object",
          "properties": {
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 144
            },
            "pitchX": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000
            },
            "pitchY": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000
            },
            "pattern": {
              "enum": [
                0,
                1,
                2,
                3,
                4
              ]
            },
            "angle": {
              "enum": [
                0,
                90,
                180,
                270
              ]
            },
            "rotateAlternates": {
              "type": "boolean"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 144
            },
            "gap": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            },
            "rotations": {
              "enum": [
                "none",
                "half",
                "quarter"
              ]
            },
            "stock": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "fit",
                    "capacity"
                  ]
                },
                "width": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 10000
                },
                "height": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 10000
                }
              },
              "required": [
                "mode",
                "width"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "capacity"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "height"
                    ]
                  }
                }
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "columns",
            "pitchX",
            "pitchY",
            "pattern",
            "angle",
            "rotateAlternates",
            "count",
            "gap",
            "rotations"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "not": {
        "required": [
          "optimized",
          "editable"
        ]
      }
    }
  },
  "required": [
    "version",
    "shape",
    "curved",
    "side",
    "seam",
    "stitches",
    "dotSize",
    "hex"
  ],
  "additionalProperties": false
}
